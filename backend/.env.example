# ==========================================
# BotFlow AI Backend - Environment Variables
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Supported chat models: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=800

# RAG & Embeddings Configuration
# Supported embedding models: text-embedding-3-small (1536 dim), text-embedding-ada-002 (1536 dim)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_MATCH_THRESHOLD=0.35
SIMILARITY_TOP_K=4
UPLOAD_MAX_SIZE_MB=15

# Supabase PostgreSQL Configuration
# Find these in your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use service role key on backend to bypass RLS for administrative actions,
# or anon key for standard user-scoped operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
# Get these from Razorpay Dashboard -> Settings -> API Keys (Test Mode: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# Webhook secret set in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
