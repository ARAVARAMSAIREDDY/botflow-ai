# ========================================================================
# BotFlow AI Backend - Production Environment Template
# ========================================================================
# Instructions:
# 1. Populate these variables in your hosting provider (Render, Railway, AWS ECS).
# 2. Never commit actual secret keys or .env files into version control.
# 3. Use cryptographically secure keys for JWT_SECRET and RAZORPAY_WEBHOOK_SECRET.
# ========================================================================

# Application Environment
NODE_ENV=production
PORT=5001

# Main Website & Client Domains (CORS Whitelist)
CLIENT_URL=https://botflow.ai
ALLOWED_ORIGINS=https://botflow.ai,https://www.botflow.ai,https://app.botflow.ai
API_BASE_URL=https://api.botflow.ai
WIDGET_PUBLIC_URL=https://api.botflow.ai/widget/botflow.js

# Reverse Proxy Trust (1 for Render, Railway, AWS ALB, Cloudflare)
TRUST_PROXY=1

# OpenAI API (Production tier)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-prod-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=800

# Google Gemini API (Alternative production AI engine)
# https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# RAG Knowledge Base Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_MATCH_THRESHOLD=0.30
SIMILARITY_TOP_K=4
UPLOAD_MAX_SIZE_MB=15

# Supabase Production Database & Storage
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Production JWT Authentication
# Generate with: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=a_very_long_secure_random_64_character_hex_string_for_production_jwt
JWT_EXPIRES_IN=7d

# Production Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Razorpay Production Billing (Live Mode)
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_configured_webhook_secret_for_live_events
