# BotFlow AI - Frontend Environment Configuration (Production)
# Configure these variables in your Vercel Project Dashboard (Settings -> Environment Variables)

# Production backend API base URL (including /api path)
VITE_API_URL=https://api.botflow.ai/api

# Standalone Embeddable JavaScript SDK script URL
VITE_WIDGET_URL=https://api.botflow.ai/widget/botflow.js

# Environment tag
VITE_APP_ENV=production
